pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- picking sticks
-- roger norberg

-->8
-- init stuff
player_x,player_y=10,10
stick_out=false
stick_delay=1
stick_x,stick_y=0,0
score=0

function _init()
 music(0)
end
-->8
-- update stuff

function _update()
 place_stick()
 move()
 pick_stick()
end

function place_stick()
 if stick_out then return end
 if stick_delay<30 then
  stick_delay+=1
  return
 end
 
 stick_x,stick_y,stick_out=rnd(113)+8,rnd(113)+8,true
 stick_delay=1
 sfx(0)
end

function move()
 old_x,old_y=player_x,player_y
	if btn(⬅️) then
		player_x=max(0,player_x-1)
		if mget(flr(player_x/8),flr(player_y/8))==10 then
	  player_x,player_y=old_x,old_y
	 end
	elseif btn(➡️) then
		player_x=min(120,player_x+1)
		if mget(flr((player_x+8)/8),flr(player_y/8))==10 then
	  player_x,player_y=old_x,old_y
	 end
	elseif btn(⬆️) then
		player_y=max(0,player_y-1)
	 if mget(flr(player_x/8),flr(player_y/8))==10 then
	  player_x,player_y=old_x,old_y
	 end
	elseif btn(⬇️) then
		player_y=min(120,player_y+1)
	 if mget(flr(player_x/8),flr((player_y+8)/8))==10 then
	  player_x,player_y=old_x,old_y
	 end
	end
end

function pick_stick()
 if stick_out == false then return end
 
 if not (
  player_x+8<=stick_x or --player is left of stick
  stick_x+8<=player_x or --stick is left of player
  player_y+8<=stick_y or --player is above stick
  stick_y+8<=player_y --stick is above player
 ) then
 	score+=1
  stick_out=false
  sfx(1)
 end
end
-->8
-- draw stuff

function _draw()
 cls()
 map()
 
 if stick_out then spr(1,stick_x,stick_y) end
 
 spr(2,player_x,player_y)
 
 print("score: ",90,2,0)
 print(score,115,2,0)
end
