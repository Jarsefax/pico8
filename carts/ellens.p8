pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- dog park
-- av ellen

-- undvika hunden

function _draw()
 cls()
 map(0,0,0,0)
 spr(1, player_x, player_y)
 spr(2, 30, 30)
end

player_x, player_y=20,20
player_speed=2

function _update()
 tmp_x, tmp_y = player_x,player_y
 if btn(⬅️) then player_x-=player_speed
 elseif btn(➡️) then player_x+=player_speed
 elseif btn(⬆️) then player_y-=player_speed
 elseif btn(⬇️) then player_y+=player_speed end
 
 spr_nr=mget(flr(player_x/8),flr(player_y/8))
 if spr_nr==8 then
  player_x,player_y=tmp_x,tmp_y
 elseif spr_nr==9
  player_x,player_y=tmp_x,tmp_y
 end
end
